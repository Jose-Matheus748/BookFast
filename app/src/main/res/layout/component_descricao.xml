<?xml version="1.0" encoding="utf-8"?>
<!--
    CORREÇÃO: Removido o android:layout_marginTop="410dp" absurdo que
    criava um espaço gigante e escondia o conteúdo.
    Agora o componente tem height="wrap_content" e é empilhado
    normalmente pelo LinearLayout pai no activity_bookpage.xml.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ctnDescricao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_container"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/lbmaterialId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:text="@string/material_livro"
        android:textColor="#F6F3F3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ldIdiomaId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:text="@string/idioma_portugu_s"
        android:textColor="#F6F3F3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lbPublicacaoId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:text="@string/publica_o_s_o_paulo_edi_es_exemplo_2007"
        android:textColor="#F6F3F3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lbEdicaoId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:text="@string/edi_o_3_ed"
        android:textColor="#F6F3F3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lbSerieId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:text="@string/s_rie_exemplo_3"
        android:textColor="#F6F3F3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lbAssuntosId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:text="@string/assuntos_exemplos"
        android:textColor="#F6F3F3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lbAutoriaId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:text="@string/autoria"
        android:textColor="#F6F3F3"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/LbAutoresId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:paddingHorizontal="10dp"
        android:paddingTop="2dp"
        android:text="@string/macedo_miguel"
        android:textColor="#F6F3F3"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>