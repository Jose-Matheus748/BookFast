<?xml version="1.0" encoding="utf-8"?>

<!-- Tela de Gestão de Pedidos -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#242424">

    <!-- Cabeçalho padrão do app -->
    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_header_admin"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Rodapé padrão do app -->
    <include
        android:id="@+id/componentFooter"
        layout="@layout/component_footer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Abas da tela: Reservas / Devoluções -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#1C1C1C"
        app:tabIndicatorColor="#19A1E4"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#19A1E4"
        app:tabTextColor="#888888"
        app:tabTextAppearance="@style/TextAppearance.AppCompat.Medium"
        app:layout_constraintTop_toBottomOf="@id/headerInclude"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Primeira aba -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservas" />

        <!-- Segunda aba -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Devoluções" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Container onde ficam os painéis de cada aba -->
    <FrameLayout
        android:id="@+id/containerTabs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toTopOf="@id/componentFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Painel da aba Reservas -->
        <ScrollView
            android:id="@+id/painelReservas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="visible">

            <!-- Conteúdo vertical da aba Reservas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <!-- Nome do primeiro usuário -->
                <TextView
                    android:id="@+id/txtUsuarioLevi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Levi Rocha"
                    android:textColor="#F1F1F1"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Card com os livros reservados por Levi -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPedidoLevi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#2E2E2E"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <!-- Conteúdo interno do card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Primeiro livro do pedido -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Capa do Livro 1 -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="78dp"
                                android:layout_height="108dp"
                                app:cardBackgroundColor="#1C1C1C"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/imgLivroPedido1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/livro1" />
                            </androidx.cardview.widget.CardView>

                            <!-- Informações do Livro 1 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="18dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtTituloLivro1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Livro 1"
                                    android:textColor="#F1F1F1"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtAutorLivro1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Autor:\nAutor 1"
                                    android:textColor="#F1F1F1"
                                    android:textSize="14sp" />

                            </LinearLayout>
                        </LinearLayout>

                        <!-- Linha divisória entre os livros do mesmo pedido -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp"
                            android:layout_marginTop="14dp"
                            android:background="#3A3A3A" />

                        <!-- Segundo livro do pedido -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Capa do Livro 2 -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="78dp"
                                android:layout_height="108dp"
                                app:cardBackgroundColor="#1C1C1C"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/imgLivroPedido2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/livro2" />
                            </androidx.cardview.widget.CardView>

                            <!-- Informações do Livro 2 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="18dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtTituloLivro2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Livro 2"
                                    android:textColor="#F1F1F1"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtAutorLivro2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Autor:\nAutor 2"
                                    android:textColor="#F1F1F1"
                                    android:textSize="14sp" />

                            </LinearLayout>
                        </LinearLayout>

                        <!-- Pergunta de confirmação da devolução -->
                        <TextView
                            android:id="@+id/txtRetiradaLevi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Devolução realizada?"
                            android:textColor="#F1F1F1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Botões de ação do pedido -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnConfirmarLevi"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#19A1E4"
                                android:text="Confirmar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                app:cornerRadius="6dp" />

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Nome do segundo usuário -->
                <TextView
                    android:id="@+id/txtUsuarioAdam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Adam Lucio"
                    android:textColor="#F1F1F1"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Card com o livro reservado por Adam -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPedidoAdam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#2E2E2E"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

                    <!-- Conteúdo interno do card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Livro do pedido de Adam -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Capa do Livro 3 -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="78dp"
                                android:layout_height="108dp"
                                app:cardBackgroundColor="#1C1C1C"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/imgLivroPedido3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/livro3" />
                            </androidx.cardview.widget.CardView>

                            <!-- Informações do Livro 3 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="18dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtTituloLivro3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Livro 3"
                                    android:textColor="#F1F1F1"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtAutorLivro3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Autor:\nAutor 3"
                                    android:textColor="#F1F1F1"
                                    android:textSize="14sp" />

                            </LinearLayout>
                        </LinearLayout>

                        <!-- Pergunta de confirmação da devolução -->
                        <TextView
                            android:id="@+id/txtRetiradaAdam"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Devolução realizada?"
                            android:textColor="#F1F1F1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Botões de ação do pedido -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnConfirmarAdam"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:backgroundTint="#19A1E4"
                                android:text="Confirmar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                app:cornerRadius="6dp" />

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- Painel da aba Devoluções.
             Começa escondido. Depois você alterna no Kotlin usando visibility. -->
        <ScrollView
            android:id="@+id/painelDevolucoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <!-- Estado simples para a aba Devoluções -->
                <TextView
                    android:id="@+id/txtSemDevolucoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Nenhuma devolução pendente."
                    android:textColor="#F1F1F1"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
