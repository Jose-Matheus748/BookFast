<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#242424">

    <!-- HEADER fixo no topo -->
    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_header"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FOOTER fixo na base -->
    <include
        android:id="@+id/componentFooter"
        layout="@layout/component_footer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ABAS -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#1C1C1C"
        app:tabIndicatorColor="#19A1E4"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#19A1E4"
        app:tabTextColor="#888888"
        app:tabTextAppearance="@style/TextAppearance.AppCompat.Medium"
        app:layout_constraintTop_toBottomOf="@id/headerInclude"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecionado" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservas" />

    </com.google.android.material.tabs.TabLayout>

    <!-- CONTEÚDO entre abas e footer -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toTopOf="@id/componentFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ===== PAINEL SELECIONADO ===== -->
        <LinearLayout
            android:id="@+id/painelSelecionado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/book_icon_homepage"
                android:contentDescription="Nenhum livro selecionado"
                android:layout_marginBottom="16dp"
                app:tint="#19A1E4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum livro por aqui"
                android:textColor="#F0F0F0"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Você ainda não tem nenhum livro selecionado."
                android:textColor="#888888"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnBuscarLivros"
                android:layout_width="200dp"
                android:layout_height="44dp"
                android:text="Buscar livros"
                android:textColor="#F0F0F0"
                android:backgroundTint="#19A1E4"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <!-- ===== PAINEL RESERVAS ===== -->
        <LinearLayout
            android:id="@+id/painelReservas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/book_icon_homepage"
                android:contentDescription="Nenhuma reserva"
                android:layout_marginBottom="16dp"
                app:tint="#19A1E4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhuma reserva por aqui"
                android:textColor="#F0F0F0"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Você ainda não tem nenhum livro reservado."
                android:textColor="#888888"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnBuscarLivrosReserva"
                android:layout_width="200dp"
                android:layout_height="44dp"
                android:text="@string/buscar_livros"
                android:textColor="#F0F0F0"
                android:backgroundTint="#19A1E4"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>