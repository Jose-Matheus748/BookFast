<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/AboutPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#242424"
    tools:context=".BookpageActivity">

    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_header"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/componentFooter"
        layout="@layout/component_footer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerInclude"
        app:layout_constraintBottom_toTopOf="@id/componentFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Capa + Título/Autor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">


                <ImageView
                    android:id="@+id/capaFortaleza"
                    android:layout_width="140dp"
                    android:layout_height="180dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fortaleza_300"
                    android:contentDescription="@string/fortaleza_em_300_palavras" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tituloLivroId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fortaleza_em_300_palavras"
                        android:textColor="#F2F0F0"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/autorCat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/autor"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/autorId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/macedo_miguel"
                        android:textColor="#F4F1F1"
                        android:textSize="14sp" />

                    <!-- Botão editar, e excluir embaixo -->
                    <LinearLayout
                        android:id="@+id/layoutEditarLivro"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:gravity="start|center"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <ImageView
                            android:id="@+id/imgPencil"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_pencil_circle"
                            android:contentDescription="Editar livro"
                            android:padding="7dp"
                            android:src="@drawable/material_symbols__edit_rounded"
                            app:tint="#FFFFFF" />

                        <ImageView
                            android:id="@+id/imgTrash"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_trash_circle"
                            android:contentDescription="Editar livro"
                            android:padding="7dp"
                            android:src="@drawable/mdi__trash_can_outline"
                            app:tint="#FFFFFF" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Abas Detalhes / Referência -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="22dp">

                <Button
                    android:id="@+id/btnDetalhes"
                    android:layout_width="0dp"
                    android:layout_height="37dp"
                    android:layout_weight="1"
                    android:backgroundTint="#19A1E4"
                    android:text="@string/detalhes"
                    android:textColor="#F0F0F0"
                    app:cornerRadius="2dp" />

                <Button
                    android:id="@+id/btnReferencia"
                    android:layout_width="0dp"
                    android:layout_height="37dp"
                    android:layout_weight="1"
                    android:backgroundTint="#434343"
                    android:text="@string/refer_ncia"
                    android:textColor="#F0F0F0"
                    app:cornerRadius="2dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/painelDetalhes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Card Descrição -->
                <LinearLayout
                    android:id="@+id/ctnDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_container"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/lbmaterialId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="8dp"
                        android:text="@string/material_livro"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ldIdiomaId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:text="@string/idioma_portugu_s"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lbPublicacaoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:text="@string/publica_o_s_o_paulo_edi_es_exemplo_2007"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lbEdicaoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:text="@string/edi_o_3_ed"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lbSerieId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:text="@string/s_rie_exemplo_3"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lbAssuntosId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:text="@string/assuntos_exemplos"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lbAutoriaId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:text="@string/autoria"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/LbAutoresId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="2dp"
                        android:text="@string/macedo_miguel"
                        android:textColor="#F6F3F3"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Exemplares -->
                <TextView
                    android:id="@+id/lbexemplaresId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/exemplares"
                    android:textColor="#F0F0F0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lbNExemplaresId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/n_mero_de_exemplares_2"
                    android:textColor="#F0F0F0"
                    android:textSize="14sp" />

                <!-- Exemplar 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_container_exemplares"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/lbRegistroCativoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:text="@string/registro_123456"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbEdicaoCativoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/edi_o_3"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbAnoCativoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/ano_2007"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbSuporteCativoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/suporte_impresso"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbLocalizacaoCativoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/localiza_o_1234_biblioteca_coordena_o_livros"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbSituacaoCativoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/situa_o_cativo"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Exemplar 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_container_exemplares"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/lbRegistroId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:text="@string/registro_123456"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbEdicaoId2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/edi_o_3"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbAnoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/ano_2007"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbSuporteId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/suporte_impresso"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbLocalizacaoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/localiza_o_1234_biblioteca_coordena_o_livros"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/lbSituacaoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingStart="8dp"
                        android:text="@string/situacao_Disponivel"
                        android:textColor="#f0f0f0"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/painelReferencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_container"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/lbReferenciaId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="8dp"
                        android:text="@string/referencia"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Botão Copiar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopiarReferencia"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#2A2A2A"
                    android:drawablePadding="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/copiar_refer_ncia"
                    android:textColor="#19A1E4"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/copy_icon"
                    app:iconTint="#19A1E4"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>