<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/AboutPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#242424"
    tools:context=".AdminBookpageActivity">

    <include
        android:id="@+id/headerInclude"
        layout="@layout/component_header_admin"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/componentFooter"
        layout="@layout/component_footer_admin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/componentFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerInclude">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ═══════════════════════════════════════
                 Capa + Título / Autor / Ações
            ════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <ImageView
                    android:id="@+id/capaFortaleza"
                    android:layout_width="140dp"
                    android:layout_height="180dp"
                    android:contentDescription="Capa do livro"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fortaleza_300" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tituloLivroId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#F2F0F0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Título do Livro" />

                    <TextView
                        android:id="@+id/autorCat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/autor"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/autorId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#F4F1F1"
                        android:textSize="14sp"
                        tools:text="Nome do Autor" />

                    <!-- Botões editar e excluir -->
                    <LinearLayout
                        android:id="@+id/layoutEditarLivro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <ImageView
                            android:id="@+id/imgPencil"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_pencil_circle"
                            android:contentDescription="Editar livro"
                            android:padding="7dp"
                            android:src="@drawable/material_symbols__edit_rounded"
                            app:tint="#FFFFFF" />

                        <ImageView
                            android:id="@+id/imgTrash"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_trash_circle"
                            android:contentDescription="Excluir livro"
                            android:padding="7dp"
                            android:src="@drawable/mdi__trash_can_outline"
                            app:tint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════
                 Abas Detalhes / Referência
            ════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <Button
                    android:id="@+id/btnDetalhes"
                    android:layout_width="0dp"
                    android:layout_height="37dp"
                    android:layout_weight="1"
                    android:backgroundTint="#19A1E4"
                    android:text="@string/detalhes"
                    android:textColor="#F0F0F0"
                    app:cornerRadius="2dp" />

                <Button
                    android:id="@+id/btnReferencia"
                    android:layout_width="0dp"
                    android:layout_height="37dp"
                    android:layout_weight="1"
                    android:backgroundTint="#434343"
                    android:text="@string/refer_ncia"
                    android:textColor="#F0F0F0"
                    app:cornerRadius="2dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════
                 Painel Detalhes
            ════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/painelDetalhes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Card de metadados do livro -->
                <LinearLayout
                    android:id="@+id/ctnDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_container"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/lbmaterialId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="8dp"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Material: Livro" />

                    <TextView
                        android:id="@+id/ldIdiomaId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Idioma: Português" />

                    <TextView
                        android:id="@+id/lbPublicacaoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Publicação: São Paulo" />

                    <TextView
                        android:id="@+id/lbEdicaoId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Edição: 3. ed." />

                    <TextView
                        android:id="@+id/lbSerieId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Série: Exemplo; 3" />

                    <TextView
                        android:id="@+id/lbAssuntosId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Assuntos: Exemplo" />

                    <TextView
                        android:id="@+id/lbAutoriaId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="4dp"
                        android:text="@string/autoria"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/LbAutoresId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="2dp"
                        android:textColor="#F6F3F3"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Autor 1, Autor 2" />
                </LinearLayout>

                <!-- ─────────────────────────────────────
                     Exemplares
                ──────────────────────────────────────── -->

                <!-- Cabeçalho da seção de exemplares -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/lbexemplaresId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/exemplares"
                        android:textColor="#F0F0F0"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Botão para criar novo exemplar -->
                    <Button
                        android:id="@+id/btnAdicionarExemplar"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#19A1E4"
                        android:paddingHorizontal="12dp"
                        android:text="+ Exemplar"
                        android:textColor="#F0F0F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- Contagem de exemplares -->
                <TextView
                    android:id="@+id/lbNExemplaresId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="16dp"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    tools:text="Número de exemplares: 2" />

                <!-- Container preenchido dinamicamente pelo Kotlin -->
                <LinearLayout
                    android:id="@+id/containerExemplares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════
                 Painel Referência
            ════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/painelReferencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_container"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/lbReferenciaId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="8dp"
                        android:textColor="#F6F3F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Referência completa aqui." />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopiarReferencia"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#2A2A2A"
                    android:drawablePadding="8dp"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/copiar_refer_ncia"
                    android:textColor="#19A1E4"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/copy_icon"
                    app:iconTint="#19A1E4"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>