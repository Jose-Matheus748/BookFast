<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#242424">

    <!-- Área scrollavel -->
    <ScrollView
        android:id="@+id/AreaScrollavel"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <!-- Conteúdo principal -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:context=".BookSelectionActivity">

            <!-- Componente Header (não fixo) -->
            <include
                android:id="@+id/componentHeader"
                layout="@layout/component_header"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Título da seção -->

            <!-- Card do Livro 1 -->

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:background="#1C1C1C"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/componentHeader"
                app:tabIndicatorColor="#19A1E4"
                app:tabIndicatorHeight="3dp"
                app:tabSelectedTextColor="#19A1E4"
                app:tabTextAppearance="@style/TextAppearance.AppCompat.Medium"
                app:tabTextColor="#888888">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/selecionado" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reservas" />

            </com.google.android.material.tabs.TabLayout>

            <TextView
                android:id="@+id/textDisponiveis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="242dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/dispon_veis"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.457"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tabLayout" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLivros"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="16dp"
                app:cardPreventCornerOverlap="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textDisponiveis">

                <!-- Layout do livro -->
                <LinearLayout
                    android:id="@+id/layoutLivro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EFEBEB"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <!-- Capa do livro-->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/capaDoLivro"
                        android:layout_width="80dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center|start"
                        app:cardBackgroundColor="#F5F5F5"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgLivro7"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/fortaleza_300" />
                    </androidx.cardview.widget.CardView>

                    <!-- Informações -->
                    <LinearLayout
                        android:id="@+id/layoutInformacoes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/tituloLivro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fortaleza_em_300_palavras"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/autoresLivro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/macedo_miguel"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <!-- Frame para customizar e deixar área de clique maior -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <!-- Checkbox -->
                        <CheckBox
                            android:id="@+id/checkLivro1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center|right"
                            android:background="@android:color/transparent"
                            android:buttonTint="#111111"
                            android:checked="true"
                            android:foregroundGravity="center_vertical"
                            app:checkedState="checked" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Card do Livro 2 -->

            <!-- Card do Livro 3 -->

            <!-- Botão de reservar livros -->

            <Button
                android:id="@+id/btnReservarLivros"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#19A1E4"
                android:text="@string/btn_reservar"
                android:textColor="#f0f0f0"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.496"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardLivros" />

            <Button
                android:id="@+id/btnReservarLivros3"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:backgroundTint="#19A1E4"
                android:text="@string/reservar_todos"
                android:textColor="#f0f0f0"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.496"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnReservarLivros" />

            <TextView
                android:id="@+id/lbindisponiveis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/indispon_veis"
                android:textColor="#f0f0f0"
                android:textSize="28sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.074"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnReservarLivros3" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLivros2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="16dp"
                app:cardPreventCornerOverlap="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lbindisponiveis">

                <LinearLayout
                    android:id="@+id/layoutLivro2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EFEBEB"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <!-- Capa do livro-->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/capaDoLivro2"
                        android:layout_width="80dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center|start"
                        app:cardBackgroundColor="#F5F5F5"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgLivro15"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Capa do livro um discurso sobre as ciencias"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/livro15" />
                    </androidx.cardview.widget.CardView>

                    <!-- Informações -->
                    <LinearLayout
                        android:id="@+id/layoutInformacoes2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/tituloLivro2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/um_discurso_sobre_as_ci_ncias"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/autoresLivro2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sousa_santos"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <!-- Frame para customizar e deixar área de clique maior -->
                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:layout_gravity="bottom|center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <!-- Checkbox -->
                        <CheckBox
                            android:id="@+id/checkLivro2"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center|right"
                            android:background="@android:color/transparent"
                            android:buttonTint="#111111"
                            android:checked="true"
                            android:foregroundGravity="center_vertical"
                            app:checkedState="checked" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnReservarLivros2"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#19A1E4"
                android:text="@string/entrar_na_fila"
                android:textColor="#f0f0f0"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.496"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardLivros2" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Componente Footer (fixo) -->
    <include
        android:id="@+id/componentFooter"
        layout="@layout/component_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>



