<?xml version="1.0" encoding="utf-8"?>
<!--
    item_livro_fila.xml
    Card de livro em fila de espera com botão "Sair da fila".
    Usado dentro do RecyclerView ou via <include> na seção "Fila de espera".
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Capa do livro -->
    <ImageView
        android:id="@+id/ivCapaLivro"
        android:layout_width="56dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_book_cover_placeholder"
        android:contentDescription="Capa do livro"
        android:scaleType="centerCrop" />

    <!-- Informações -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTituloLivro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Livro 3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvLabelDisponivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponível em"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvDataDisponivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20/01/27"
            android:textColor="#00B0F0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Botão Sair da fila -->
        <Button
            android:id="@+id/btnSairFila"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_outline_red"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Sair da fila"
            android:textColor="#FF6666"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>